        self.__pin = pin

    def verify_pin(self) :
        history = read_file()

        try :
            if self.account_id in history.keys() :
                if history[self.account_id]["PIN"] == int(self.__pin) :
                    print(f"ACCOUNT HOLDER : {history[self.account_id]["NAME"]}\naccount type : {history[self.account_id]["ACCOUNT TYPE"]}\nBALANCE : {history[self.account_id]["BALANCE"]}")
                    login_menu(self.account_id)
                else :
                    print("PIN DOESN'T MATCH")
            else :
                print("ACCOUNT NOT FOUND")

        except KeyError :
            print("INVALID ACCOUNT NUMBER")

        except ValueError :
            print("INVALID INTEGER")


