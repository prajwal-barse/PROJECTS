        print("="*162)
        print(wlc_msg.center(160))
        print("="*162)

        print(f"1.DEPOSIT\n2.WITHDRAW\n3.VIEW BALANCE\n4.VIEW TRANSACTION HISTORY\n5.CHANGE ACCOUNT NAME\n6.CHANGE PIN\n7.DELETE ACCOUNT\n8.TRANSFER\n9.LOGOUT")

        choice = input("ENTER YOUR CHOICE :")

        working_account = bank_account(history[account_id]["NAME"], history[account_id]["PIN"], history[account_id]["ACCOUNT TYPE"], account_id, balance=history[account_id]["BALANCE"])

