                    print("AMOUNT CAN'T BE LESS THAN ₹1")

                else :
                    working_account.deposit(deposit)

            except ValueError :
                print("INVALID INTEGER")

        elif choice == "2" :
            try :
                withdraw = int(input("CHOOSE AMOUNT TO WITHDRAW :"))
                if withdraw <= 0 :
                    print("AMOUNT CAN'T BE LESS THAN ₹1")

                else :
                    if withdraw > history[account_id]["BALANCE"] :
                        print("YOU CAN'T WITHDRAW MORE THAN YOUR BALANCE")

                    else :
                        working_account.withdraw(withdraw)

                

            except ValueError :
                print("INVALID INTEGER")

        elif choice == "3" :
            working_account.view_balance()

        elif choice == "4" :
            working_account.TransactionHistory(account_id)

        elif choice == "5" :
            working_account.change_name()

        elif choice == "6" :
            working_account.change_pin()    

        elif choice == "7" :
            result = working_account.delete_account()

            if result == "DONE" :
                break

        elif choice == "8" :
            history = read_file()
            receiver_id = input("ENTER RECEIVER'S ACCOUNT NUMBER :")
            if receiver_id in history :
                try :
                    amount = int(input(f"ENTER AMOUNT TO TRANSFER TO {history[receiver_id]["NAME"]} :"))
                    if amount <= 0 :
                        print("AMOUNT CAN'T BE LESS THAN ₹1")
    
                    else :
                        working_account.transfer(receiver_id, amount)
    
                except ValueError :
                    print("INVALID INTEGER")
    
            else :
                print("RECIVER ACCOUNT NOT FOUND")
            
        elif choice == "9" :
            print("ACCOUNT CLOSED SUCESSFULLY")
