def show_summary() :     #5   
    spending = []
    total_spending = 0
    highest_spending = 0
    lowest_spending = 0
    categories = set()
    avalible_keys = []


    expenses = read_file()
    if len(expenses) == 0 :
        print("no expenses found")
    else :
        for keys in expenses.keys() :
            avalible_keys.append(keys)
        for key in avalible_keys :
            amt = int(expenses[key]["AMOUNT"])
            categories.add(expenses[key]["CATEGORY"])
            spending.append(amt)
            total_spending = sum(spending)
        print(f"{"-"*140} ")
        print(f"TOTAL SPENDING : RS.{total_spending}")
        print(" ")

        for category in categories :
            category_amount = 0
            category = str(category)
            for key in avalible_keys :
                c = str(expenses[key]["CATEGORY"])
                if c == category :
                    z = int(expenses[key]["AMOUNT"])
                    category_amount += z
            print(f"{category} : RS.{category_amount}")
        print(" ")
        print(f"HIGHEST SPENDING : {max(spending)} \nLOWEST SPENDING : {min(spending)}")
        print(f"NO. OF EXPENSES : {len(expenses)}")
        print(" ")
        print(f"AVARAGE SPENDING : RS.{int(total_spending/len(expenses))}")

