def read_file() :
    verify_existance()
    with open("history.json", "r") as history_read :
        expenses = json.load(history_read) 
        return expenses


def save_file(expenses) :
    with open("history.json", "w") as history_write :
            json.dump(expenses,history_write,indent=4)


