def print_details(expenses, key) :
    print(f"{"-"*140} ")
    print(f"{key}.")
    print(f"CATEGORY : {expenses[key]["CATEGORY"]}")
    print(f"NAME : {expenses[key]["NAME"]}")
    print(f"AMOUNT : {expenses[key]["AMOUNT"]}")
    print(f"{"-"*140} ")

       
def add_expense() :      #1
    
    category = input("enter the category :")
    category = category.lower().strip()
    if category == "" :
        print("CATEGORY CAN'T BE EMPTY")
        return
    product_name = input("enter the product name :")
    product_name = product_name.lower().strip()
    if product_name == "" :
        print("NAME CAN'T BE EMPTY")
        return
    try :
        amount = input("enter the amount :")
        if amount.strip() == "" :
            print("AMOUNT CAN'T BE EMPTY")
            return
        else :
            amount = float(amount)

    except ValueError :
        print("INVALID INPUT \nENTER A NUMBER")
        return

    expenses = read_file()
    id_list = []
    for key in expenses.keys() :
        key = int(key)
        id_list.append(key)
    if len(id_list) == 0 :
        highest_id = 1
    else :
        length = len(id_list) - 1
        id_list.sort()
        highest_id = id_list[length] + 1
        
    # print(highest_id)
    expenses[highest_id] = {}
    expenses[highest_id]["CATEGORY"] = category
    expenses[highest_id]["NAME"] = product_name
    expenses[highest_id]["AMOUNT"] = amount
    save_file(expenses)
    print(" ")
    print(f"expense number : {len(expenses)}")
    print(" ")
    print("expense added sucessfully !!")


