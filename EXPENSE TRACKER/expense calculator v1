expenses = {}
def add_expense() :         #1
    for value in range(len(expenses) + 1, len(expenses) + 2) :
        expenses[value] = {}
    category = input("enter your product category :")
    expenses[value]["category"] = category
    with open("tracker.txt","a") as tracker :
        tracker.write(f"CATEGORY : {category} \n")
    name = input("enter your product name :")
    expenses[value]["name"] = name
    with open("tracker.txt","a") as tracker :
       tracker.write(f"NAME : {name} \n")
    while True :
        try :
            amount = int(input("enter your product amount :"))
            break
        except ValueError :
            print("invalid input")
    expenses[value]["amount"] = amount 
    with open("tracker.txt","a") as tracker :
        tracker.write(f"AMOUNT : {amount} \n")
    with open("tracker.txt","a") as tracker :
        tracker.write("----------------------------------------------------------------------------------------------------------------------- \n")

def print_library() :       #7
    print(expenses)

