def serach_expense() :      #3
    while True :
        print("1.BY NAME \n2.BY CATEGORY")
        choice3 = str(input("select your method to search :"))
        found = False
        if choice3 == "1" :
            word_search = str(input("enter product to search :"))
            for val in expenses :
                if word_search in expenses[val]["name"] :
                    found = True
                else :
                    found = False
                if found :
                    print(expenses[val])
            if found == False :
                print("NOT FOUND")
            break
        elif choice3 == "2" :
            word_search = str(input("enter product to search :"))
            for val in expenses :
                if word_search in expenses[val]["category"] :
                    found = True
                else :
                    found = False
                if found :
                    print(expenses[val])
                break
            if found == False :
                print("NOT FOUND")
                break
        else :
            print("invalid integer")
        
def show_spending() :       #5
    addition = 0
    for val in expenses :
        expenses[val]["amount"] = int(expenses[val]["amount"])
        addition += expenses[val]["amount"]
    print(f"your total spending is Rs.{addition}")

def expense_tracker() :
    while True :
        try :
            print("============================================================= EXPENSE TRACKER ==============================================================")
            print("1.ADD EXPENSE \n2.VIEW ALL EXPENSE \n3.SEARCH EXPENSE \n4.DELETE EXPENSE \n5.SHOW TOTAL SPENDING \n6.EXIT")
            choice = int(input("enter your choice :"))
            if choice == 1 :
                add_expense()
            elif choice == 2 :
                view_expense()
            elif choice == 3 :
                serach_expense()
